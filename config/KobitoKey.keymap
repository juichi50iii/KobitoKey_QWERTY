#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "keys_ja.h"

/ {
    combos { compatible = "zmk,combos"; };

    behaviors {
        Delete_Backspace: Delete_Backspace {
            compatible = "zmk,behavior-mod-morph";
            label = "DELETE_BACKSPACE";
            bindings = <&kp DELETE>, <&kp BACKSPACE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        sel_us_0: sel_us_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&to 0>;
        };
        sel_jp: sel_jp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&to 4>;
        };
        sel_us_2: sel_us_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&to 0>;
        };
        sel_us_3: sel_us_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>, <&to 0>;
        };
        sel_us_4: sel_us_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4>, <&to 4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Character_US {
            label = "USChar";
            bindings = <
&kp Q           &kp W           &kp E             &kp R               &kp T         &kp Y        &kp U         &kp I         &kp O  &kp P
&kp A           &kp S           &kp D             &kp F               &kp G         &kp H        &kp J         &kp K         &kp L  &mo 3
&none           &kp Z           &kp X             &kp C               &kp V         &kp B        &kp N         &kp M         &none  &Delete_Backspace
&kp LANGUAGE_1  &kp LANGUAGE_2  &kp LEFT_CONTROL  &mt LEFT_SHIFT TAB  &lt 1 RETURN  &lt 2 SPACE  &kp LEFT_ALT  &kp LEFT_GUI  &to 0  &to 4
            >;
        };

        Symbol_US {
            label = "USSym";
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN    &kp HASH       &kp DOLLAR        &kp PERCENT     &kp CARET  &kp AMPERSAND      &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp GRAVE        &kp COMMA      &kp BACKSLASH  &kp LEFT_BRACKET  &kp MINUS       &kp EQUAL  &kp RIGHT_BRACKET  &kp SLASH     &kp PERIOD            &kp SINGLE_QUOTE
&kp TILDE        &kp LESS_THAN  &kp PIPE       &kp LEFT_BRACE    &kp UNDERSCORE  &kp PLUS   &kp RIGHT_BRACE    &kp QUESTION  &kp GREATER_THAN      &kp DOUBLE_QUOTES
&none            &none          &none          &none             &none           &none      &none              &none         &kp SEMICOLON         &kp COLON
            >;
        };

        Number {
            label = "NUMBER";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PLUS      &kp MINUS  &kp F1   &kp F2   &kp F3      &kp F4  &kp F5
&kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp ASTERISK  &kp SLASH  &kp F6   &kp F7   &kp F8      &kp F9  &kp F10
&kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp DOT       &kp COMMA  &kp F11  &kp F12  &none       &none   &none
&kp NUMBER_0  &kp EQUAL     &none         &none         &none      &none    &none    &kp ESCAPE  &none   &none
            >;
        };

        Mouse {
            label = "mouse";
            bindings = <
&to 0         &to 4           &none           &none           &none            &sel_us_0   &sel_jp         &sel_us_2       &sel_us_3       &sel_us_4        
&none         &none           &none           &kp UP_ARROW    &none            &mkp LCLK   &mkp MCLK       &mkp RCLK       &none           &none
&none         &none           &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &mkp MB4    &none           &mkp MB5        &none           &none
&bt BT_CLR    &bt BT_CLR_ALL  &none           &none           &none            &none       &none           &none           &none           &soft_off
            >;
        };

        Character_JP {
            label = "JPChar";
            bindings = <
&kp Q           &kp W           &kp E             &kp R               &kp T         &kp Y        &kp U         &kp I         &kp O  &kp P
&kp A           &kp S           &kp D             &kp F               &kp G         &kp H        &kp J         &kp K         &kp L  &mo 3
&none           &kp Z           &kp X             &kp C               &kp V         &kp B        &kp N         &kp M         &none  &Delete_Backspace
&kp LANGUAGE_1  &kp LANGUAGE_2  &kp LEFT_CONTROL  &mt LEFT_SHIFT TAB  &lt 5 RETURN  &lt 2 SPACE  &kp LEFT_ALT  &kp LEFT_GUI  &to 0  &to 4
            >;
        };

        Symbol_JP {
            label = "JPSym";
            bindings = <
&kp JA_EXCL   &kp JA_AT      &kp JA_HASH  &kp JA_DLLR     &kp JA_PRCNT    &kp JA_CARET  &kp JA_AMPS     &kp JA_ASTER  &kp JA_LPAR     &kp JA_RPAR
&kp JA_GRAVE  &kp JA_COMMA   &kp JA_RO    &kp JA_LBRC     &kp JA_MINUS    &kp JA_EQUAL  &kp JA_RBRC     &kp JA_SLASH  &kp JA_DOT      &kp JA_SQT
&kp JA_TILDE  &kp JA_LT      &kp JA_PIPE  &kp JA_LBRACE   &kp JA_UNDER    &kp JA_PLUS   &kp JA_RBRACE   &kp JA_QMARK  &kp JA_GT       &kp JA_DQUOT
&none         &none          &none        &none           &none           &none         &none           &none         &kp JA_SEMI     &kp JA_COLON
            >;
        };
    };
};
